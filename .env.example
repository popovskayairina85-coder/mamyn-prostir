# База / database
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=mamyn_prostir

# Вхід команди в /api/mp-admin (довгий випадковий рядок) / team access token
MP_ADMIN_TOKEN=

# ШІ-навігатор (необов'язково; вимкнений, доки не ввімкнути в налаштуваннях після 20 тестів)
ANTHROPIC_API_KEY=
MP_AI_MODEL=claude-haiku-5-5

# Листи «новий пароль» (необов'язково)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Адреси проксі, яким вірити в X-Real-IP (через кому)
TRUSTED_PROXIES=127.0.0.1/32
